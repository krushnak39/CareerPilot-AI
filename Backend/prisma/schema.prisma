generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  fullName             String
  email                String             @unique
  password             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  provider             String             @default("credentials")
  githubId             String?            @unique
  googleId             String?            @unique
  linkedinId           String?            @unique
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  activities           Activity[]
  careerPreference     CareerPreference?
  interviewSessions    InterviewSession[]
  jobApplications      JobApplication[]
  learningProgress     LearningProgress[]
  learningRoadmaps     LearningRoadmap[]
  resumes              Resume[]
  skillGaps            SkillGap[]
  studyMaterials       StudyMaterial[]
  userActivities       UserActivity[]
  profile              UserProfile?
  userSkills           UserSkill[]
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  phone                String?
  bio                  String?
  location             String?
  college              String?
  degree               String?
  graduationYear       Int?
  skills               String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  notificationsEnabled Boolean  @default(true)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  targetRole        String?
  preferredLocation String?
  workMode          String?
  jobType           String?
  experienceLevel   String?
  industries        String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id        String          @id @default(cuid())
  userId    String
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  isPrimary Boolean         @default(false)
  fileSize  Int?
  title     String?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions  ResumeVersion[]
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())
  fileSize  Int?
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id          String    @id @default(cuid())
  userId      String
  jobTitle    String
  company     String
  location    String?
  jobType     String?
  description String?
  status      String    @default("SAVED")
  appliedDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id          String    @id @default(cuid())
  userId      String
  title       String
  type        String?
  company     String?
  role        String?
  status      String    @default("PLANNED")
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Skill {
  id                    String                  @id @default(cuid())
  name                  String                  @unique
  category              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  LearningResourceSkill LearningResourceSkill[]
  SkillGap              SkillGap[]
  UserSkill             UserSkill[]
}

model LearningResource {
  id                    String                  @id @default(cuid())
  title                 String
  description           String?
  type                  String
  url                   String?
  provider              String?
  difficulty            String?
  durationMin           Int?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  LearningProgress      LearningProgress[]
  LearningResourceSkill LearningResourceSkill[]
}

model LearningProgress {
  id               String           @id @default(cuid())
  userId           String
  resourceId       String
  progress         Int              @default(0)
  status           String           @default("not_started")
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  LearningResource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model LearningResourceSkill {
  id               String           @id @default(cuid())
  resourceId       String
  skillId          String
  createdAt        DateTime         @default(now())
  LearningResource LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  Skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([resourceId, skillId])
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  proficiency Int?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model SkillGap {
  id            String   @id @default(cuid())
  userId        String
  skillId       String
  targetRole    String
  currentLevel  Int?
  requiredLevel Int?
  priority      String   @default("medium")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, targetRole])
}

model UserActivity {
  id         String   @id @default(cuid())
  userId     String
  type       String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
}

model StudyMaterial {
  id         String   @id @default(cuid())
  userId     String
  title      String
  fileName   String
  storedName String
  filePath   String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model LearningRoadmap {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String?
  role        String?
  isTemplate  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules     RoadmapModule[]

  @@index([userId])
  @@index([createdAt])
}

model RoadmapModule {
  id          String          @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  roadmap     LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      RoadmapTopic[]

  @@index([roadmapId])
  @@index([order])
}

model RoadmapTopic {
  id          String        @id @default(cuid())
  moduleId    String
  title       String
  description String?
  order       Int           @default(0)
  completed   Boolean       @default(false)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  module      RoadmapModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([order])
  @@index([dueDate])
}
